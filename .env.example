# LLM API Configuration
# Copy this file to .env and fill in your own API credentials.
# All three agent roles have independent API configurations.

# ========== Patient Agent API ==========
PATIENT_API_BASE=https://your-api-endpoint
PATIENT_API_KEY=sk-your-key
PATIENT_MODEL=your-model-name

# ========== Patient-backup API ==========
PATIENT_BACKUP_API_BASE=https://your-api-endpoint
PATIENT_BACKUP_API_KEY=sk-your-key
PATIENT_BACKUP_MODEL=your-model-name

# ========== Doctor Agent API ==========
DOCTOR_API_BASE=https://your-api-endpoint
DOCTOR_API_KEY=sk-your-key
DOCTOR_MODEL=your-model-name

# ========== Evaluator API ==========
EVALUATOR_API_BASE=https://your-api-endpoint
EVALUATOR_API_KEY=sk-your-key
EVALUATOR_MODEL=your-model-name

# ========== Evaluator1 API ==========
EVALUATOR_1_API_BASE=https://your-api-endpoint
EVALUATOR_1_API_KEY=sk-your-key
EVALUATOR_1_MODEL=your-model-name

# ========== Evaluator2 API ==========
EVALUATOR_2_API_BASE=https://your-api-endpoint
EVALUATOR_2_API_KEY=sk-your-key
EVALUATOR_2_MODEL=your-model-name

# ========== Evaluator3 API ==========
EVALUATOR_3_API_BASE=https://your-api-endpoint
EVALUATOR_3_API_KEY=sk-your-key
EVALUATOR_3_MODEL=your-model-name

# ========== Evaluator4 API ==========
EVALUATOR_4_API_BASE=https://your-api-endpoint
EVALUATOR_4_API_KEY=sk-your-key
EVALUATOR_4_MODEL=your-model-name

# ========== Evaluator5 API ==========
EVALUATOR_5_API_BASE=https://your-api-endpoint
EVALUATOR_5_API_KEY=sk-your-key
EVALUATOR_5_MODEL=your-model-name

# ========== Instrument API ==========
INSTRUMENT_API_BASE=https://your-api-endpoint
INSTRUMENT_API_KEY=sk-your-key
INSTRUMENT_MODEL=your-model-name

# ========== Instrument-backup API ==========
INSTRUMENT_BACKUP_API_BASE=https://your-api-endpoint
INSTRUMENT_BACKUP_API_KEY=sk-your-key
INSTRUMENT_BACKUP_MODEL=your-model-name

# ========== Common Settings ==========
MAX_TOKENS=16384
TEMPERATURE=0.7
TIMEOUT=1200.0
